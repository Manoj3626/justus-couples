# ==================================================
# JustUs ❤️ — Environment Configuration
# ==================================================
# Copy this to .env and fill in real values
# NEVER commit .env to version control

# --- Server ---
PORT=5000
NODE_ENV=production

# --- Security ---
# REQUIRED in production — server will NOT start without this
JWT_SECRET=your_strong_random_jwt_secret_here

# --- CORS ---
# REQUIRED in production — server will NOT start without this
# Set to your frontend deployment URL
CORS_ORIGIN=https://justus.netlify.app
FRONTEND_URL=https://justus.netlify.app

# --- Database ---
# REQUIRED in production — server will NOT start without this
# Use MongoDB Atlas for production
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/justus_db?retryWrites=true&w=majority

# --- Cloud Storage ---
# REQUIRED in production — server will NOT start without cloud storage configured
# At least one of CLOUDINARY_URL or AWS_S3_BUCKET must be set
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or alternatively:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=justus-media-bucket

# --- Email (SMTP) ---
# Optional — if unset, OTP is logged to console (dev only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@justus.app
SMTP_PASS=your_app_specific_password
SMTP_FROM="JustUs ❤️" <noreply@justus.app>

# --- Google OAuth 2.0 ---
# Optional — if unset, Google login is disabled
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- AI Date Suggestions (Google Gemini) ---
# Optional — if unset, curated fallback suggestions are returned
GEMINI_API_KEY=
